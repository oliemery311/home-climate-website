{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1xthx4bxpbzmz.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1jq4o6yq14o4c.js\"/><script src=\"/_next/static/chunks/1de9myc15dqxx.js\" async=\"\"></script><script src=\"/_next/static/chunks/3hdj40qmts5sf.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1c556wmd80d39.js\" async=\"\"></script><script src=\"/_next/static/chunks/158myu8e_yme3.js\" async=\"\"></script><script src=\"/_next/static/chunks/1g_qz06v6p_n4.js\" async=\"\"></script><title>Home Climate Solutions | Air Conditioning Installation Leicester</title><meta name=\"description\" content=\"Professional residential air conditioning installation across Leicester and the Midlands. Bedrooms, home offices, lounges and multi-room systems.\"/><meta name=\"keywords\" content=\"air conditioning installation,home air conditioning,bedroom air conditioning,home office air conditioning,air conditioning installer Leicester,multi split systems\"/><meta name=\"robots\" content=\"index, follow\"/><meta property=\"og:title\" content=\"Home Climate Solutions | Residential Air Conditioning\"/><meta property=\"og:description\" content=\"Comfortable homes, professionally installed air conditioning.\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Home Climate Solutions | Residential Air Conditioning\"/><meta name=\"twitter:description\" content=\"Comfortable homes, professionally installed air conditioning.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur\"><div class=\"container flex h-20 items-center justify-between\"><a href=\"/\" class=\"text-xl font-bold text-slate-900\">Home Climate Solutions</a><nav class=\"hidden items-center gap-8 md:flex\"><a href=\"#services\" class=\"text-sm font-medium text-slate-700 hover:text-blue-600\">Services</a><a href=\"#process\" class=\"text-sm font-medium text-slate-700 hover:text-blue-600\">Process</a><a href=\"#faq\" class=\"text-sm font-medium text-slate-700 hover:text-blue-600\">FAQ</a><a href=\"#quote\" class=\"   rounded-lg   bg-blue-600   px-5   py-3   text-sm   font-semibold   text-white   hover:bg-blue-700   \">Free Quote</a></nav></div></header><main><section class=\"bg-slate-50\"><div class=\"container grid gap-12 py-20 md:grid-cols-2 md:items-center md:py-32\"><div><p class=\"mb-5 font-semibold text-blue-600\">Residential Air Conditioning Installation</p><h1 class=\"   text-4xl   font-bold   leading-tight   text-slate-900   md:text-6xl   \">Comfortable homes, professionally installed air conditioning.</h1><p class=\"   mt-6   max-w-xl   text-lg   leading-relaxed   text-slate-600   \">Stay comfortable throughout the year with reliable air conditioning designed for bedrooms, home offices, lounges and multi-room homes.</p><div class=\"mt-8 flex flex-wrap gap-4\"><a href=\"#quote\" class=\"rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition hover:bg-blue-700\">Request a Free Quote</a><a href=\"#services\" class=\"   rounded-lg   border   border-slate-300   px-7   py-4   font-semibold   text-slate-700   hover:bg-white   \">View Services</a></div><div class=\"mt-10 grid grid-cols-3 gap-4 text-sm\"><div><strong class=\"block text-slate-900\">F-Gas</strong>Certified</div><div><strong class=\"block text-slate-900\">Local</strong>Installer</div><div><strong class=\"block text-slate-900\">Free</strong>Quotations</div></div></div><div class=\"   flex   min-h-[350px]   items-center   justify-center   rounded-3xl   bg-slate-200   \"><div class=\"text-center text-slate-500\"><p class=\"text-6xl\">❄️</p><p class=\"mt-4 font-medium\">Installation Gallery Image</p></div></div></div></section><section class=\"py-20\"><div class=\"container\"><div class=\"mx-auto max-w-3xl text-center\"><h2 class=\"text-3xl font-bold text-slate-900 md:text-4xl\">More comfort in every room</h2><p class=\"mt-4 text-lg text-slate-600\">Air conditioning is more than just cooling. Modern systems improve comfort throughout the year.</p></div><div class=\"mt-12 grid gap-6 md:grid-cols-3\"><div class=\"   rounded-2xl   border   border-slate-200   bg-white   p-8   shadow-sm   \"><h3 class=\"text-xl font-semibold text-slate-900\">Better Sleep</h3><p class=\"mt-3 text-slate-600\">Keep bedrooms comfortable during hot summer nights with quiet, efficient cooling.</p></div><div class=\"   rounded-2xl   border   border-slate-200   bg-white   p-8   shadow-sm   \"><h3 class=\"text-xl font-semibold text-slate-900\">Comfortable Workspaces</h3><p class=\"mt-3 text-slate-600\">Maintain a comfortable temperature in your home office all year round.</p></div><div class=\"   rounded-2xl   border   border-slate-200   bg-white   p-8   shadow-sm   \"><h3 class=\"text-xl font-semibold text-slate-900\">Heating &amp; Cooling</h3><p class=\"mt-3 text-slate-600\">Modern air conditioning systems provide efficient heating as well as cooling.</p></div></div></div></section><section id=\"services\" class=\"bg-slate-50 py-20\"><div class=\"container\"><h2 class=\"   text-center   text-3xl   font-bold   text-slate-900   md:text-4xl   \">Our Services</h2><div class=\"   mt-12   grid   gap-5   sm:grid-cols-2   lg:grid-cols-3   \"><div class=\"   rounded-xl   bg-white   p-6   shadow-sm   \"><h3 class=\"   font-semibold   text-slate-900   \">Single Split Systems</h3><p class=\"   mt-2   text-sm   text-slate-600   \">Professional installation designed around your home.</p></div><div class=\"   rounded-xl   bg-white   p-6   shadow-sm   \"><h3 class=\"   font-semibold   text-slate-900   \">Multi Split Systems</h3><p class=\"   mt-2   text-sm   text-slate-600   \">Professional installation designed around your home.</p></div><div class=\"   rounded-xl   bg-white   p-6   shadow-sm   \"><h3 class=\"   font-semibold   text-slate-900   \">Bedroom Air Conditioning</h3><p class=\"   mt-2   text-sm   text-slate-600   \">Professional installation designed around your home.</p></div><div class=\"   rounded-xl   bg-white   p-6   shadow-sm   \"><h3 class=\"   font-semibold   text-slate-900   \">Home Office Air Conditioning</h3><p class=\"   mt-2   text-sm   text-slate-600   \">Professional installation designed around your home.</p></div><div class=\"   rounded-xl   bg-white   p-6   shadow-sm   \"><h3 class=\"   font-semibold   text-slate-900   \">Lounge &amp; Conservatory Cooling</h3><p class=\"   mt-2   text-sm   text-slate-600   \">Professional installation designed around your home.</p></div></div></div></section><section id=\"process\" class=\"py-20\"><div class=\"container\"><h2 class=\"   text-center   text-3xl   font-bold   text-slate-900   md:text-4xl   \">A simple installation process</h2><div class=\"   mt-12   grid   gap-6   md:grid-cols-4   \"><div class=\"   rounded-2xl   border   border-slate-200   p-6   \"><div class=\"   mb-4   flex   h-10   w-10   items-center   justify-center   rounded-full   bg-blue-600   font-bold   text-white   \">1</div><p class=\"text-slate-700\">Tell us about your home</p></div><div class=\"   rounded-2xl   border   border-slate-200   p-6   \"><div class=\"   mb-4   flex   h-10   w-10   items-center   justify-center   rounded-full   bg-blue-600   font-bold   text-white   \">2</div><p class=\"text-slate-700\">Upload photos and requirements</p></div><div class=\"   rounded-2xl   border   border-slate-200   p-6   \"><div class=\"   mb-4   flex   h-10   w-10   items-center   justify-center   rounded-full   bg-blue-600   font-bold   text-white   \">3</div><p class=\"text-slate-700\">Receive your quotation</p></div><div class=\"   rounded-2xl   border   border-slate-200   p-6   \"><div class=\"   mb-4   flex   h-10   w-10   items-center   justify-center   rounded-full   bg-blue-600   font-bold   text-white   \">4</div><p class=\"text-slate-700\">Professional installation</p></div></div></div></section><section class=\"bg-slate-950 py-20 text-white\"><div class=\"container\"><h2 class=\"   text-center   text-3xl   font-bold   md:text-4xl   \">Why choose Home Climate Solutions?</h2><div class=\"   mt-12   grid   gap-4   md:grid-cols-3   \"><div class=\"   rounded-xl   bg-white/10   p-6   \">F-Gas certified installation</div><div class=\"   rounded-xl   bg-white/10   p-6   \">Residential air conditioning specialists</div><div class=\"   rounded-xl   bg-white/10   p-6   \">Friendly local service</div><div class=\"   rounded-xl   bg-white/10   p-6   \">Clean and tidy workmanship</div><div class=\"   rounded-xl   bg-white/10   p-6   \">Quality manufacturer options</div><div class=\"   rounded-xl   bg-white/10   p-6   \">Clear honest quotations</div></div></div></section><section id=\"faq\" class=\"py-20\"><div class=\"container\"><h2 class=\"   text-center   text-3xl   font-bold   text-slate-900   \">Frequently Asked Questions</h2><div class=\"   mx-auto   mt-10   max-w-3xl   space-y-5   \"><div class=\"   rounded-xl   border   border-slate-200   p-6   \"><h3 class=\"   font-semibold   text-slate-900   \">Can air conditioning heat as well as cool?</h3><p class=\"   mt-2   text-slate-600   \">Yes. Modern systems provide efficient heating as well as cooling.</p></div><div class=\"   rounded-xl   border   border-slate-200   p-6   \"><h3 class=\"   font-semibold   text-slate-900   \">How long does installation take?</h3><p class=\"   mt-2   text-slate-600   \">Most residential installations are completed within one day.</p></div><div class=\"   rounded-xl   border   border-slate-200   p-6   \"><h3 class=\"   font-semibold   text-slate-900   \">Which manufacturers do you install?</h3><p class=\"   mt-2   text-slate-600   \">We install systems from leading manufacturers including Mitsubishi Electric, Daikin and others.</p></div><div class=\"   rounded-xl   border   border-slate-200   p-6   \"><h3 class=\"   font-semibold   text-slate-900   \">Can I cool multiple rooms?</h3><p class=\"   mt-2   text-slate-600   \">Yes. Multi split systems allow several indoor units connected to one outdoor unit.</p></div></div></div></section><section id=\"quote\" class=\"   bg-blue-600   py-20   text-white   \"><div class=\"container text-center\"><h2 class=\"   text-3xl   font-bold   md:text-4xl   \">Ready to make your home more comfortable?</h2><p class=\"   mx-auto   mt-4   max-w-2xl   text-blue-100   \">Tell us about your home and we will provide a free quotation.</p><a href=\"mailto:hello@homeclimatesolutions.co.uk\" class=\"   mt-8   inline-block   rounded-lg   bg-white   px-8   py-4   font-semibold   text-blue-700   \">Request a Quote</a></div></section><section id=\"quote\" class=\"scroll-mt-20 bg-slate-50 py-20\"><div class=\"mx-auto max-w-3xl px-4\"><h2 class=\"text-3xl font-bold\">Request a Free Quote</h2><p class=\"mt-3 text-slate-600\">Tell us about your home and we will recommend the right air conditioning solution.</p><div class=\"mt-8 flex gap-2\"><div class=\"h-2 flex-1 rounded bg-blue-600\"></div><div class=\"h-2 flex-1 rounded bg-slate-200\"></div><div class=\"h-2 flex-1 rounded bg-slate-200\"></div><div class=\"h-2 flex-1 rounded bg-slate-200\"></div></div><div class=\"mt-8 rounded-xl bg-white p-6 shadow\"><div><h3 class=\"text-xl font-semibold\">About your home</h3><label class=\"mt-6 block\">Property type<select class=\"mt-2 w-full rounded border p-3\"><option value=\"\" selected=\"\">Select</option><option>Detached</option><option>Semi-detached</option><option>Terraced</option><option>Flat</option><option>Bungalow</option><option>Other</option></select></label><label class=\"mt-4 block\">Room type<select class=\"mt-2 w-full rounded border p-3\"><option value=\"\" selected=\"\">Select</option><option>Bedroom</option><option>Home office</option><option>Lounge</option><option>Conservatory</option><option>Multiple rooms</option><option>Other</option></select></label></div><div class=\"mt-8 flex justify-between\"><span></span><button class=\"rounded bg-blue-600 px-5 py-3 text-white\">Continue</button></div></div></div></section></main><!--$--><!--/$--><script src=\"/_next/static/chunks/1jq4o6yq14o4c.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/158myu8e_yme3.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/158myu8e_yme3.js\\\"],\\\"default\\\"]\\nf:I[68027,[\\\"/_next/static/chunks/158myu8e_yme3.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/1xthx4bxpbzmz.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/1xthx4bxpbzmz.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/158myu8e_yme3.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"children\\\":[\\\"$\\